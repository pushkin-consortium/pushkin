# main directories relative to project root ('..')
experimentsDir: 'experiments'
usersDir: 'users'
coreDir: 'pushkin'
DockerHubID: ''

# databases configs experiments can use
databases:
  local:
    experiment:
      user: 'postgres'
      pass: 'example'
      url: 'localhost'
      port: '5432'
      name: 'local-experiment-db'
      host: 'local-experiment-db'

# basic site configuration
info:
  rootDomain: 'localhost'
  whoAmI: 'Citizen Science Website'
  hashtags: 'science, learn'
  email: 'me@mydomain.com'
  shortName: 'CSW'
addons:
  useForum: false
  useAuth: false
salt: 'abc123'
fc: {
  popup: false
}